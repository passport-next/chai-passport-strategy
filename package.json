    "name": "Rowan Wookey",
    "email": "admin@rwky.net"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/passport-next/chai-passport-strategy.git"
  },
  "bugs": {
    "url": "http://github.com/passport-next/chai-passport-strategy/issues"
  },
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  ],
  "main": "./lib/index.js",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "chai": "6.x.x",
    "eslint-config-ash-nazg": "^42.3.1",
    "make-node": "0.4.x",
    "mocha": "11.x.x"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm tsc",
